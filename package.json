  "license": "MIT",
  "main": "index.js",
  "files": ["index.js", "sign.js", "README.md"],
  "engines": { "node": ">=18" },
  "dependencies": { "@bamboodeploy/cli": "github:bamboodeploy/cli#v1.1.0" },
