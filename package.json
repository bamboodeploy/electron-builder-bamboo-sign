  "peerDependenciesMeta": { "electron-builder": { "optional": true } },
  "repository": { "type": "git", "url": "https://github.com/bamboodeploy/electron-builder-bamboo-sign" },
  "homepage": "https://www.bamboodeploy.com/docs/#electron",
  "keywords": ["electron-builder", "code-signing", "windows", "smartscreen", "authenticode", "nsis"]
}
